node_modules/
*.log
.env
.env.local
.next/
out/
.vercel
data/outputs/*
!data/outputs/.gitkeep
*.db
*:Zone.Identifier
.DS_Store
ml/models/*.pth
ml/.venv/

# onnxruntime-web's wasm backends, copied out of node_modules by `npm run
# sync:ort` (wired into prebuild, so Vercel regenerates them on deploy).
# ~42MB of build output that would otherwise be committed twice over.
public/ort/


# Redundant: every entry is already committed extracted under data/IMAGES
# and data/pranav images/satellite plotted building/
data/pranav images/*.zip

# Scratch outputs from the detection/benchmark scripts
/tmp_geogov/

# Ultralytics training scratch: run logs, auto-downloaded base weights, and the
# tiled YOLO dataset — all regenerable from data/ground_truth via
# `python -m ml.building_detector.prepare_yolo`. Only the trained checkpoint
# (ml/models/yolo_parcel.pt) is committed.
runs/
weights/
yolo*.pt
!ml/models/yolo_parcel.pt
data/yolo_parcels/
